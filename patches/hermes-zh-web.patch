+}
+
+/** Locale-aware label for an elapsed duration in seconds. */
+export function formatDelta(delta: number): string {
+  const zh = isZhLocale();
+  if (delta < 0 || Number.isNaN(delta)) return zh ? "\u672a\u77e5" : "unknown";
+  if (delta < 60) return zh ? "\u521a\u521a" : "just now";
+  if (delta < 3600) {
+    const n = Math.floor(delta / 60);
+    return zh ? `${n} \u5206\u949f\u524d` : `${n}m ago`;
+  }
+  if (delta < 86400) {
+    const n = Math.floor(delta / 3600);
+    return zh ? `${n} \u5c0f\u65f6\u524d` : `${n}h ago`;
+  }
+  if (delta < 172800) return zh ? "\u6628\u5929" : "yesterday";
+  const n = Math.floor(delta / 86400);
+  return zh ? `${n} \u5929\u524d` : `${n}d ago`;
+}
+
+function isZhLocale(): boolean {
+  if (typeof window === "undefined") return false;
+  try {
+    const w = window as unknown as { __HERMES_LOCALE__?: string };
+    const v = w.__HERMES_LOCALE__ || localStorage.getItem("hermes.locale") || "";
+    return String(v).toLowerCase().startsWith("zh");
+  } catch {
+    return false;
+  }
 }
 
